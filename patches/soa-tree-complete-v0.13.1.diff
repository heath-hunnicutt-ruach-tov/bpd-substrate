+// Pre-allocate SoA shadows for all Q8_0 weight tensors in the graph.
+// Called once on first graph_compute — before any inference runs.
+// This avoids cudaMalloc during the dispatch hot path (which disrupts multi-stream).
+static void soa_preallocate_shadows(ggml_cgraph * cgraph, cudaStream_t stream) {
+    static bool done = false;
+    if (done || !getenv("GGML_CUDA_Q8_0_SOA") && !getenv("GGML_SOA_KERNEL")) return;
+    done = true;
+    int count = 0;
+    for (int i = 0; i < cgraph->n_nodes; i++) {
+        ggml_tensor * node = cgraph->nodes[i];
+        if (node->op != GGML_OP_MUL_MAT) continue;
+        ggml_tensor * w = node->src[0];
+        if (!w || w->type != GGML_TYPE_Q8_0) continue;
+        if (w->ne[1] > 16384) continue;
+        // Check if shadow already exists
+        soa_shadow_entry existing = soa_shadow_lookup(w->data);
+        if (existing.quants) continue;
+        int64_t ne00 = w->ne[0];
+        int64_t ne01 = w->ne[1];
+        int bpr = (int)(ne00 / 32);
+        size_t quant_bytes = (size_t)ne01 * ne00;
+        size_t scale_bytes = (size_t)ne01 * bpr * 2;
+        void *q_buf = nullptr, *s_buf = nullptr;
+        cudaMalloc(&q_buf, quant_bytes);
+        cudaMalloc(&s_buf, scale_bytes);
+        int total = (int)(ne01 * bpr);
+        int rp_thr = 256, rp_blk = (total + rp_thr - 1) / rp_thr;
+        repack_q8_0_aos_to_soa<<<rp_blk, rp_thr, 0, stream>>>(
+            (const uint8_t *)w->data, (uint8_t *)q_buf, (uint8_t *)s_buf,
+            bpr, (int)ne00, total);
+        soa_shadow_register(w->data, q_buf, s_buf);
+        // Verify weight data is populated
+        if (count < 3) {
+            cudaStreamSynchronize(stream);
+            unsigned char check[4];
+            cudaMemcpy(check, w->data, 4, cudaMemcpyDeviceToHost);
+            fprintf(stderr, "VERIFY w='%s' data=%p first4=%02x%02x%02x%02x\n",
+                w->name ? w->name : "?", w->data, check[0], check[1], check[2], check[3]);
+        }
+        if (count < 200) {
+            fprintf(stderr, "REGISTER: name='%s' data=%p ne01=%lld q=%p\n",
+                w->name ? w->name : "NULL", w->data, (long long)ne01, q_buf);
+        }
+        count++;
+    }
+    if (count > 0) {
+        cudaStreamSynchronize(stream);
+        fprintf(stderr, "SoA: pre-allocated %d shadows\n", count);
+    }
+}
